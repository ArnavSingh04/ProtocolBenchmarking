# Copy this file to `.env.local` and fill in real values.
# The app runs fully offline with sane defaults — every value below is OPTIONAL.

# --- Persistence -----------------------------------------------------------
# There is nothing to configure. Runs are stored per-browser in localStorage;
# the server keeps no state and needs no database.

# --- Simulation --------------------------------------------------------------
# Delay (ms) between simulated steps, so live progress is visible.
# Set to 0 for instant runs (used automatically in tests).
# SIM_STEP_MS=220

# --- Live mode endpoints -----------------------------------------------------
# Only used when a benchmark is run in "Live" mode. In "Simulation" mode
# (the default) these are ignored and no network calls are made.
# MQTT_BROKER_URL="mqtt://broker.emqx.io:1883"
# HTTP_TEST_URL="https://postman-echo.com/post"
# WEBSOCKET_URL="wss://echo.websocket.org"
# COAP_SERVER_URL="coap://coap.me"
